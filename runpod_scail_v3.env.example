# MeetMap SCAIL-2 V4 / Google Drive + Seed-VC automation
# Copy these names into RunPod environment variables / secrets.
# NEVER commit the real service-account private key to GitHub.

# Preferred: entire Google service-account JSON stored as a RunPod secret.
GOOGLE_SERVICE_ACCOUNT_JSON=

# Alternative to GOOGLE_SERVICE_ACCOUNT_JSON:
# GOOGLE_SERVICE_ACCOUNT_FILE=/run/secrets/google-service-account.json

# Google Drive folder ID of:
# MeetMap TikTok Content -> Queue
# The runtime verifies both folder names and refuses any other path.
# Share the parent folder MeetMap TikTok Content with the service-account email as Editor.
MEETMAP_MOTION_DRIVE_FOLDER_ID=

# These are optional overrides. The defaults below are already built into the node.
MEETMAP_MOTION_EXPECTED_FOLDER_NAME=Queue
MEETMAP_MOTION_EXPECTED_PARENT_FOLDER_NAME=MeetMap TikTok Content

# Completed source videos are moved from Queue to the sibling folder "Already posted".
# Normally leave the ID empty so the runtime resolves the sibling by name.
MEETMAP_MOTION_PROCESSED_FOLDER_ID=
MEETMAP_MOTION_PROCESSED_FOLDER_NAME=Already posted

# Fixed creator_01 voice reference stored in:
# MeetMap TikTok Content -> Voice References -> creator_01_reference.flac
# These values are already built into the custom node and are shown here for explicit overrides.
MEETMAP_CREATOR_VOICE_DRIVE_FILE_ID=1BjZUeye3fVAkA1DtvdlYdsNQzMY_gANt
MEETMAP_CREATOR_VOICE_SHA256=e0c502c490c74bbda5226fae8fb95206bb6facf1eb2d1d2ff025b19f9ae62fb7
