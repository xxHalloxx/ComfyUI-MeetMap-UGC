# MeetMap SCAIL-2 V3 / Google Drive automation
# Copy these names into RunPod environment variables / secrets.
# NEVER commit the real service-account private key to GitHub.

# Preferred: entire Google service-account JSON stored as a RunPod secret.
GOOGLE_SERVICE_ACCOUNT_JSON=

# Alternative to GOOGLE_SERVICE_ACCOUNT_JSON:
# GOOGLE_SERVICE_ACCOUNT_FILE=/run/secrets/google-service-account.json

# Google Drive folder containing motion-reference videos.
# Share this folder with the service-account email as Editor.
MEETMAP_MOTION_DRIVE_FOLDER_ID=

# Optional. If set, successfully rendered source videos are moved here.
# If empty, files stay in the source folder but receive meetmap_processed=true.
MEETMAP_MOTION_PROCESSED_FOLDER_ID=
